# Local benchmark origin exposed to the comparison app (used by launcher links).
# Safe default: http://localhost:3001
NEXT_PUBLIC_BENCHMARK_ORIGIN=http://localhost:3001

# Server-side origin the browser runner navigates to. Journeys may never
# leave this origin. Safe default: http://localhost:3001
BENCHMARK_ORIGIN=http://localhost:3001

# Directory where comparison records, journeys, and screenshots are stored.
# Safe default: <current working directory>/data
# CHOICEMIRROR_DATA_DIR=./data

# Phase 3 — Nebius Token Factory (OpenAI-compatible). Required only for AI
# mode; deterministic runs need no credentials. Next.js reads these from
# apps/web/.env.local (gitignored) — store the real key there or in the
# server environment. Never commit a real key.
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_MODEL=zai-org/GLM-5.3-Flash
