{
  "name": "choicemirror",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @choicemirror/web --filter @choicemirror/benchmark dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@choicemirror/browser-runner": "workspace:^",
    "@choicemirror/contracts": "workspace:^",
    "@playwright/test": "^1.65.1",
    "@types/node": "^25.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
